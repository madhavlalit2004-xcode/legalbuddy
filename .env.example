# Application Settings
APP_NAME="AI Legal Buddy"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=1

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=1

# ChromaDB
CHROMA_PERSIST_DIR="./chroma_db"
CHROMA_COLLECTION_NAME="legal_documents"

# Embedding Model
EMBEDDING_MODEL="all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32

# Chunking Config
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_LENGTH=50

# Document Storage
UPLOAD_DIR="./data/uploads"
MAX_FILE_SIZE_MB=50

# Search Config
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# API
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OLLAMA_TIMEOUT_SECONDS=30
SECRET_KEY=
